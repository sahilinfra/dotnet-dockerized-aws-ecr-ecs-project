aws_region   = "us-east-1"
project_name = "sampleapp"
environment  = "production"

# Production-like deployments usually run ECS tasks in private subnets.
ecs_subnet_type    = "private"
assign_public_ip   = false
enable_nat_gateway = true
create_rds         = false

# Optional HTTPS and DNS settings.
# certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/example"
# hosted_zone_id  = "Z0000000000000000000"
# domain_name     = "app.example.com"

tags = {
  Owner = "portfolio"
}
