aws_region   = "us-east-1"
project_name = "sampleapp"
environment  = "dev"

# Keep public subnets for a low-cost portfolio demo.
# For a production-like setup, use ecs_subnet_type = "private",
# assign_public_ip = false, and enable_nat_gateway = true.
ecs_subnet_type    = "public"
assign_public_ip   = true
enable_nat_gateway = false

# Optional HTTPS and DNS settings.
# certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/example"
# hosted_zone_id  = "Z0000000000000000000"
# domain_name     = "app.example.com"

create_rds = false

tags = {
  Owner = "portfolio"
}
